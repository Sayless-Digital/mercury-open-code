{
  "name": "mercury-coder",
  "version": "1.0.0",
  "description": "AI-powered code editor with OpenCode integration",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:whisper\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:whisper": "cd backend-whisper && python3 -m uvicorn main:app --reload --port 8001",
    "dev:electron": "NODE_ENV=development electron .",
    "postinstall": "electron-rebuild -f -w better-sqlite3 node-pty",
    "build": "vite build && electron-builder",
    "build:win": "vite build && electron-builder --win",
    "build:mac": "vite build && electron-builder --mac",
    "build:linux": "vite build && electron-builder --linux",
    "preview": "vite preview"
  },
  "keywords": [
    "code-editor",
    "ai",
    "opencode",
    "whisper",
    "electron",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "vite": "^5.0.0",
    "vue": "^3.4.0",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@monaco-editor/loader": "^1.4.0",
    "@opencode-ai/sdk": "file:../opencode-backend/packages/sdk/js",
    "@vueuse/core": "^10.7.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "better-sqlite3": "^9.2.2",
    "chokidar": "^4.0.3",
    "lucide-vue-next": "^0.555.0",
    "marked": "^17.0.1",
    "monaco-editor": "^0.45.0",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.0.0",
    "pinia": "^2.1.7",
    "sortablejs": "^1.15.6",
    "vue-router": "^4.2.5",
    "vuedraggable": "^4.1.0"
  },
  "build": {
    "appId": "com.mercury.coder",
    "productName": "Mercury Coder",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend-whisper/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  }
}
